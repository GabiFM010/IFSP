def particionar_passo_a_passo(vetor, inicio, fim, passos):
    pivo = vetor[fim]
    i = inicio - 1
    passos.append(f"--- Particionando de {inicio} a {fim} (Pivô: {pivo}) ---")
    passos.append(f"Estado inicial do trecho: {vetor[inicio:fim+1]}")
    
    for j in range(inicio, fim):
        if vetor[j] < pivo:
            i += 1
            vetor[i], vetor[j] = vetor[j], vetor[i]
            passos.append(f"j={j} (elemento {vetor[i]} < {pivo}): trocou com i={i}. Vetor atual: {vetor.copy()}")
        else:
            passos.append(f"j={j} (elemento {vetor[j]} >= {pivo}): não troca. Vetor atual: {vetor.copy()}")
            
    vetor[i+1], vetor[fim] = vetor[fim], vetor[i+1]
    passos.append(f"Troca final do pivô para a posição {i+1}: {vetor.copy()}")
    return i + 1
def quicksort_passo_a_passo(vetor, inicio, fim, passos):
    if inicio < fim:
        pi = particionar_passo_a_passo(vetor, inicio, fim, passos)
        quicksort_passo_a_passo(vetor, inicio, pi - 1, passos)
        quicksort_passo_a_passo(vetor, pi + 1, fim, passos)
