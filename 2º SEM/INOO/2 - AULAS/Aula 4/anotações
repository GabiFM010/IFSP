class Bicicleta {
    // atributos (variáveis de instância)
    private int velocidade = 0;
    private int engrenagem = 1;
    private int cadencia = 0; // o private nn permite nem alteração nem leitura, pra alterar isso precisa de um metodo

    // construtor
    Bicicleta(int velocidade) {
        this.velocidade = velocidade;
    }

    // métodos (comportamentos)
    void mudarCadencia(int cadencia) {
        this.cadencia = cadencia;
    }

    void mudarEngrenagem(int novaEngrenagem) {
        engrenagem = novaEngrenagem;
    }

    void frear() {
        cadencia = cadencia - 1;
        velocidade = velocidade - 5;

        if (velocidade < 0) {
            velocidade = 0;
        }

        if (cadencia < 0) {
            cadencia = 0;
        }
    }
}
